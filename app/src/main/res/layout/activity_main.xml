<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="MultiHook 聚合助手"
            app:titleTextColor="#1F2937" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 模块激活状态卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvModuleStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LSPosed 模块已就绪 (API 101)"
                        android:textColor="#059669"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="采用现代 LibXposed 规范与 DexKit 字节码全版本通杀引擎"
                        android:textColor="#6B7280"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 1. 红果短剧卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎬 红果免费短剧"
                            android:textColor="#111827"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnRestartHongGuo"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_alignParentEnd="true"
                            android:paddingHorizontal="12dp"
                            android:text="强停生效"
                            android:textSize="12sp" />
                    </RelativeLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchHongGuo1080p"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="强制 1080P 最高画质 (防弱网降档)" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchHongGuoVip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="免广与会员特权注入" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchHongGuoAds"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="去除贴片与 Lynx 卡片广告" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchHongGuoHotfix"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="屏蔽官方 Reparo 热更新对抗" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. 番茄小说卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📖 番茄免费小说"
                            android:textColor="#111827"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnRestartFanQie"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_alignParentEnd="true"
                            android:paddingHorizontal="12dp"
                            android:text="强停生效"
                            android:textSize="12sp" />
                    </RelativeLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchFanQieVip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="免广阅读特权" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchFanQieAds"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="去除章节末尾插页广告" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchFanQieTts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="解锁高品质 AI 听书音色" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchFanQiePendant"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="隐藏金币福袋悬浮挂件" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. 哔哩哔哩卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📺 哔哩哔哩"
                            android:textColor="#111827"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnRestartBili"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_alignParentEnd="true"
                            android:paddingHorizontal="12dp"
                            android:text="强停生效"
                            android:textSize="12sp" />
                    </RelativeLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchBiliSplash"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="秒过/去除开屏广告" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchBiliFeedAds"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="净化首页推荐流卡片广告" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchBiliBgPlay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="解锁后台音频播放" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
